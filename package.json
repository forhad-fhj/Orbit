{
  "name": "social-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "db:push": "npm run db:push -w packages/prisma",
    "db:generate": "npm run db:generate -w packages/prisma"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "next": "16.3.1"
  }
}
