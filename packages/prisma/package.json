{
  "name": "@socialplatform/prisma",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:push": "npx prisma@5.22.0 db push --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma@5.22.0 generate --schema=./prisma/schema.prisma",
    "db:migrate": "npx prisma@5.22.0 migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "npx prisma@5.22.0 studio --schema=./prisma/schema.prisma",
    "db:seed": "npx prisma@5.22.0 db seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
