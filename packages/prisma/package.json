{
  "name": "@socialplatform/prisma",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:push": "npm exec -- prisma db push --schema=./prisma/schema.prisma",
    "db:generate": "npm exec -- prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "npm exec -- prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "npm exec -- prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "npm exec -- prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
